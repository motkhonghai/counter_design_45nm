#@ source ${SCRIPT_PATH}/6_chip_finish.tcl
#@ Begin verbose source /home/icd1/workspace/counter_design_45nm/physical_design/6_chip_finish.tcl (pre)
set STAGE  6_chip_finish
set DESIGN counter
set PROJECT_PATH /home/icd1/workspace/counter_design_45nm
set INPUT_DB    ${PROJECT_PATH}/physical_design/outputs/mmmc/counter_post_route
set OUTPUT_PATH ${PROJECT_PATH}/physical_design/outputs/mmmc
set REPORT_PATH ${PROJECT_PATH}/physical_design/reports/mmmc/6_chip_finish
set OUTPUT_DB   ${PROJECT_PATH}/physical_design/outputs/mmmc/counter_finish
file mkdir $OUTPUT_PATH
file mkdir $REPORT_PATH
if {[info exists PD_DATABASE_LOADED] && $PD_DATABASE_LOADED} {
puts "Use design already loaded in memory"
}
set_db delaycal_enable_si true
set_db extract_rc_engine post_route
set_db extract_rc_effort_level high
extract_rc
report_timing -late  -max_paths 100 > [file join $REPORT_PATH setup.rpt]
report_timing -early -max_paths 100 > [file join $REPORT_PATH hold.rpt]
report_area  > [file join $REPORT_PATH area.rpt]
report_power > [file join $REPORT_PATH power.rpt]
check_drc > [file join $REPORT_PATH drc.rpt]
check_connectivity > [file join $REPORT_PATH connectivity.rpt]
write_db $OUTPUT_DB
puts "Done $STAGE"
puts "Saved database: $OUTPUT_DB"
#@ End verbose source /home/icd1/workspace/counter_design_45nm/physical_design/6_chip_finish.tcl
#@ source ${SCRIPT_PATH}/7_export.tcl
#@ Begin verbose source /home/icd1/workspace/counter_design_45nm/physical_design/7_export.tcl (pre)
set STAGE  7_export
set DESIGN counter
set PROJECT_PATH /home/icd1/workspace/counter_design_45nm
set INPUT_DB    ${PROJECT_PATH}/physical_design/outputs/mmmc/counter_finish
set OUTPUT_PATH ${PROJECT_PATH}/physical_design/outputs/mmmc
set REPORT_PATH ${PROJECT_PATH}/physical_design/reports/mmmc/7_export
set OUTPUT_DB   ${PROJECT_PATH}/physical_design/outputs/mmmc/counter_final
set NETLIST     ${PROJECT_PATH}/physical_design/outputs/mmmc/counter_post_pnr.v
set DEF_FILE    ${PROJECT_PATH}/physical_design/outputs/mmmc/counter_post_pnr.def
set SLOW_SDC    ${PROJECT_PATH}/physical_design/outputs/mmmc/counter_post_pnr_view_wcl_slow.sdc
set FAST_SDC    ${PROJECT_PATH}/physical_design/outputs/mmmc/counter_post_pnr_view_wcl_fast.sdc
set STREAM_MAP  ${PROJECT_PATH}/physical_design/streamOut.map
set GDS_FILE    ${PROJECT_PATH}/physical_design/outputs/mmmc/counter_final.gds
file mkdir $OUTPUT_PATH
file mkdir $REPORT_PATH
if {![file exists $STREAM_MAP]} {...}
if {[info exists PD_DATABASE_LOADED] && $PD_DATABASE_LOADED} {
puts "Use design already loaded in memory"
}
write_db $OUTPUT_DB
write_netlist $NETLIST
write_def $DEF_FILE
write_sdc -view view_wcl_slow > $SLOW_SDC
write_sdc -view view_wcl_fast > $FAST_SDC
write_stream -map_file $STREAM_MAP $GDS_FILE
puts "Final runtime and memory:"
time_info FINAL
puts "Done $STAGE"
puts "Saved database: $OUTPUT_DB"
puts "Netlist: $NETLIST"
puts "DEF: $DEF_FILE"
puts "GDSII: $GDS_FILE"
#@ End verbose source /home/icd1/workspace/counter_design_45nm/physical_design/7_export.tcl
puts "Full physical-design flow completed"
